rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Un documento per (utente, macchinetta, bevanda):
    // id = <uid>_<machineId>_<drinkId>  → un solo voto per bevanda, ma modificabile.
    match /ratings/{ratingId} {

      // Chi ha fatto l'accesso (anche anonimo) può leggere i voti,
      // serve per calcolare le medie.
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['uid', 'machineId', 'drinkId', 'drinkKey', 'value', 'updatedAt'])
        && request.resource.data.keys().hasAll(
             ['uid', 'machineId', 'drinkId', 'drinkKey', 'value', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.machineId is string
        && request.resource.data.drinkId is string
        && request.resource.data.machineId in
             ['terzo', 'quarto-principale', 'quarto-secondaria',
              'sesto-principale', 'sesto-secondaria']
        && request.resource.data.drinkId in
             ['espresso', 'caffe-lungo', 'caffe-macchiato', 'caffe-al-ginseng-dolce',
              'caffe-macchiato-al-ginseng-dolce', 'cappuccino-al-ginseng-dolce', 'cappuccino',
              'cappuccino-con-cioccolato', 'bevanda-cioccolato', 'latte', 'latte-macchiato',
              'bevanda-te-al-limone', 'espresso-premium', 'caffe-lungo-premium',
              'caffe-macchiato-premium', 'cappuccino-premium', 'caffe-decaffeinato',
              'caffe-macchiato-decaffeinato', 'cappuccino-decaffeinato', 'caffe-d-orzo',
              'cappuccino-d-orzo', 'caffe-al-ginseng', 'caffe-macchiato-al-ginseng',
              'cappuccino-al-ginseng', 'caffe-d-orzo-macchiato', 'bevanda-latte',
              'bevanda-latte-macchiato']
        && request.resource.data.drinkKey ==
             request.resource.data.machineId + '_' + request.resource.data.drinkId
        && ratingId == request.auth.uid + '_' + request.resource.data.drinkKey
        && request.resource.data.value is number
        && request.resource.data.value >= 0
        && request.resource.data.value <= 5
        && request.resource.data.value * 2 == math.floor(request.resource.data.value * 2)
        && request.resource.data.updatedAt == request.time
        // una recensione ogni 5 minuti: il voto si scrive insieme all'orario in limits/<uid>
        && getAfter(/databases/$(database)/documents/limits/$(request.auth.uid)).data.last == request.time;

      allow delete: if false;
    }

    // Orario dell'ultima recensione di ogni utente (solo il codice anonimo come id): serve a far passare
    // 5 minuti tra una recensione e la successiva.
    match /limits/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.keys().hasAll(['last'])
        && request.resource.data.last == request.time
        && (resource == null || request.time >= resource.data.last + duration.value(5, 'm'));

      allow delete: if false;
    }
  }
}
